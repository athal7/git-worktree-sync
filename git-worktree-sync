#!/bin/sh
# git-worktree-sync - Hard-reset root checkouts to remote default branches
#
# Iterates over repos under $CODE_DIR that have git worktrees and:
# 1. Fetches the default branch from the primary remote (upstream if present, otherwise origin)
# 2. Hard-resets the repository root's checked-out branch to that remote branch.
#
# This discards local-only commits from the checked-out branch. Dirty changes are
# stashed with a tagged message before the reset; recover them with `git stash list`
# / `git stash apply`.
#
# Designed to run on a schedule via LaunchAgent. Pairs well with
# `git maintenance` prefetch for near-instant fetches.

set -eu

if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
  cat <<'EOF'
Usage: git-worktree-sync [--help]

Hard-resets the checked-out root to the default branch under $CODE_DIR (default: $HOME/code)
in repos with active worktrees.
EOF
  exit 0
fi

CODE_DIR="${CODE_DIR:-${HOME}/code}"
LOG_TAG="git-worktree-sync"

log() { logger -t "$LOG_TAG" "$@" 2>/dev/null; printf '%s %s\n' "$(date +%H:%M:%S)" "$*"; }

for repo in "$CODE_DIR"/*/; do
  [ -d "$repo/.git" ] || continue

  # Only process repos with active linked worktrees.
  worktree_dir="$repo/.git/worktrees"
  [ -d "$worktree_dir" ] && [ "$(ls -A "$worktree_dir" 2>/dev/null)" ] || continue

  name=$(basename "$repo")

  # Determine sync source: if an upstream remote exists, origin is a fork —
  # sync from upstream (the primary repo). Otherwise sync from origin.
  if git -C "$repo" remote | grep -qx upstream 2>/dev/null; then
    sync_remote="upstream"
  else
    sync_remote="origin"
  fi

  # Detect default branch: worktrunk config > sync_remote/HEAD > skip
  default_branch=$(git -C "$repo" config worktrunk.default-branch 2>/dev/null) || \
  default_branch=$(git -C "$repo" symbolic-ref "refs/remotes/$sync_remote/HEAD" 2>/dev/null | sed "s|refs/remotes/$sync_remote/||") || {
    log "$name: skipped (no default branch detected)"
    continue
  }
  checked_out_branch=$(git -C "$repo" symbolic-ref --quiet --short HEAD 2>/dev/null) || checked_out_branch="detached"
  if ! git -C "$repo" fetch --quiet "$sync_remote" "$default_branch" 2>/dev/null; then
    log "$name: fetch failed"
    continue
  fi

  remote_ref=$(git -C "$repo" rev-parse "refs/remotes/$sync_remote/$default_branch" 2>/dev/null) || {
    log "$name: no remote $default_branch ref"
    continue
  }
  head_ref=$(git -C "$repo" rev-parse HEAD 2>/dev/null) || continue

  # Already reset to the selected remote default.
  [ "$head_ref" != "$remote_ref" ] || continue

  short_remote=$(echo "$remote_ref" | cut -c1-8)

  # If the root checkout is dirty, stash before the reset so edits remain recoverable.
  # Tag auto-stashes so they can be distinguished from human-created ones.
  if [ -n "$(git -C "$repo" status --porcelain 2>/dev/null)" ]; then
    stash_msg="git-worktree-sync auto-stash $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    if git -C "$repo" stash push --include-untracked --quiet --message "$stash_msg" 2>/dev/null; then
      log "$name: $checked_out_branch had local mods, stashed before hard-reset to $sync_remote/$default_branch ($short_remote)"
    else
      log "$name: $checked_out_branch had local mods, stash failed, skipping"
      continue
    fi
  else
    log "$name: $checked_out_branch hard-reset to $sync_remote/$default_branch ($short_remote)"
  fi

  # Hard reset so HEAD, index, and working tree stay coherent. Using
  # `update-ref` here would leave the index and worktree at the old commit,
  # which is exactly the corruption mode this script used to cause.
  git -C "$repo" reset --hard --quiet "$remote_ref"
done
